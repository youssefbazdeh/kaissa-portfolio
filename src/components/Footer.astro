---
import site from '../data/site.json';
const c = site.contact;
const year = new Date().getFullYear();
---

<footer class="footer wrap">
  <span>{site.name}</span>
  <span>All rights reserved · {year}</span>
  <span class="links">
    {c.email ? <a href={`mailto:${c.email}`}>[Email]</a> : <span class="todo">[Email]</span>}
    {c.linkedin ? <a href={c.linkedin} target="_blank" rel="noopener">[LinkedIn]</a> : <span class="todo">[LinkedIn]</span>}
  </span>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 1rem;
    padding-block: 1.25rem 2rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-s);
    font-weight: 500;
    text-transform: uppercase;
  }
  .links { display: flex; gap: 1.25rem; }
  .links a:hover { opacity: 0.55; }
  .todo { color: var(--muted); }
  @media (max-width: 760px) {
    .footer { grid-template-columns: 1fr; }
  }
</style>
